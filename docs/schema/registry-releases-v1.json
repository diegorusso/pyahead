{
  "$id": "https://pyahead.dev/schema/registry-releases-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "releases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected_final_on": {
            "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})(?![\\s\\S])",
            "type": "string"
          },
          "python": {
            "pattern": "^(?:3\\.(0|[1-9][0-9]{0,2}))(?![\\s\\S])",
            "type": "string"
          },
          "released_on": {
            "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})(?![\\s\\S])",
            "type": "string"
          },
          "source": {
            "format": "uri",
            "pattern": "^(?:(?![\\s\\S]*[\\ud800-\\udfff])https://(?![^/?#]*@)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?::(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]*)?)(?![\\s\\S])",
            "type": "string"
          },
          "status": {
            "enum": [
              "eol",
              "security",
              "stable",
              "prerelease",
              "planned"
            ],
            "type": "string"
          }
        },
        "required": [
          "python",
          "status"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "releases"
  ],
  "title": "PyAhead registry Python releases schema version 1",
  "type": "object",
  "x-pyahead-semantic-validation": [
    "dates are real calendar dates",
    "releases are strictly ordered by Python version"
  ]
}
