{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegorusso/pyahead/schemas/implementation-result.json",
  "title": "PyAhead autopilot implementation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "status",
    "summary",
    "files_changed",
    "acceptance_criteria_addressed",
    "commands_reportedly_run",
    "limitations",
    "blocking_reason"
  ],
  "properties": {
    "milestone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "acceptance_criteria_addressed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "commands_reportedly_run": {
      "type": "array",
      "items": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blocking_reason": {
      "type": ["string", "null"]
    }
  }
}
