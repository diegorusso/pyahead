{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegorusso/pyahead/schemas/review-result.json",
  "title": "PyAhead autopilot review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "verdict",
    "findings",
    "acceptance_evidence_inspected",
    "blocking_reason"
  ],
  "properties": {
    "milestone": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "changes_requested", "blocked"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "file",
          "line",
          "explanation",
          "required_remediation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"]
          },
          "explanation": {
            "type": "string"
          },
          "required_remediation": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_evidence_inspected": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blocking_reason": {
      "type": ["string", "null"]
    }
  }
}
